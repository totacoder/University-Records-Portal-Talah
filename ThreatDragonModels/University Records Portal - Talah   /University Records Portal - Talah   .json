              "threats": [
                {
                  "id": "d1b0e07e-6944-49d1-bfdd-ac1e4cb56f47",
                  "title": "TM-01",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "طالبة مسجلة الدخول تغيّر معرّف السجل في الطلب. غياب التحقق من ملكية السجل يسمح بعرض درجات طالبة ثانية. الأثر هو فقدان سرية معلومات الطالبات.",
                  "mitigation": "التحقق من أن السجل يخص صاحبة الحساب عند كل طلب، ورفض الوصول غير المصرح وتسجيل المحاولة. المسؤول فريق تطوير البوابة. معيار التحقق: حساب الطالبة أ يطلب سجل الطالبة ب، فيرفض النظام الطلب وتظهر المحاولة في السجل. هذه حماية مقترحة لم تُنفّذ أو تُختبر.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "01691195-5314-4e82-8304-024e98b771f3",
                  "title": "TM-02",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": ": مستخدم مسجل الدخول يستدعي وظيفة تعديل درجات مقرر ما يملك صلاحية عليه. غياب التحقق من صلاحية المقرر يسمح بتغيير الدرجات. الأثر هو فقدان سلامة البيانات.",
                  "mitigation": "قصر تعديل الدرجة على عضو التدريس المخوّل لهذا المقرر، والتحقق من الصلاحية مع كل تعديل، وتسجيل التغييرات. المسؤول فريق تطوير البوابة. معيار التحقق: حساب غير مخوّل يحاول التعديل فيرفض النظام الطلب ويسجل المحاولة. الحماية مقترحة ولم تُختبر.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "da25963c-c48d-437d-b81d-966f5b7c1ab3",
                  "title": "TM-03",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": ": مستخدم يرسل طلبات تصدير كبيرة ومتكررة. عدم وجود حدود لمعدل الطلبات وحجم العمل قد يستنفد موارد قاعدة البيانات، فيبطئ الخدمة أو يوقفها.",
                  "mitigation": "وضع حدود لمعدل الطلبات وحجم التصدير والمهلة الزمنية، واستخدام طابور للعمليات الكبيرة. المسؤول فريق تشغيل النظام. معيار التحقق: اختبار حمل محدود ومصرّح به يثبت تطبيق الحدود واستمرار الخدمة. نكتب المعيار فقط؛ لا ننفذ حملًا على بوابة حقيقية.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                }
              ],
